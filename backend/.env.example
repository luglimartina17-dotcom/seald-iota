# -- Backend (.env) --
# Copy this file as .env and fill in the values

# IOTA RPC URL (testnet)
IOTA_RPC=https://api.testnet.iota.cafe

# API Key for protecting sensitive endpoints (choose a secret string)
API_KEY=your-secret-api-key

# Allowed origins for CORS (frontend Vite)
ALLOWED_ORIGINS=http://localhost:5173

# HMAC key for signing audit payloads (change in production)
AUDIT_SIGNING_KEY=dev-audit-secret

# Network label for audit records
AUDIT_NETWORK=testnet
